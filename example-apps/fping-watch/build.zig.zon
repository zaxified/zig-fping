.{
    .name = .fping_watch,
    .version = "0.0.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x35ee980ba83c73f5,
    .paths = .{ "build.zig", "build.zig.zon", "src", "targets.json", "smoke.sh", "README.md" },
    .dependencies = .{
        // The library from this repository's checkout. A copy of this
        // directory taken on its own would pin a release instead:
        //   .url = "git+https://github.com/zaxified/zig-fping#v0.2.0",
        //   .hash = "...",            (zig fetch --save <url> fills it in)
        .zig_fping = .{ .path = "../.." },
    },
}
