#!/bin/sh
# What dh_installsystemd generates: enable the service on first install
# (and keep an admin's disable on upgrades), then start or restart it. A
# service that fails to start does not fail the installation: its status
# and /healthz tell why. deb-systemd-invoke also honours policy-rc.d.
set -e
case "$1" in
    configure | abort-upgrade | abort-deconfigure | abort-remove)
        deb-systemd-helper unmask fping-watch.service >/dev/null || true
        # was-enabled is true on a first install.
        if deb-systemd-helper --quiet was-enabled fping-watch.service; then
            deb-systemd-helper enable fping-watch.service >/dev/null || true
        else
            deb-systemd-helper update-state fping-watch.service >/dev/null || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            if [ -n "$2" ]; then action=restart; else action=start; fi
            deb-systemd-invoke "$action" fping-watch.service >/dev/null || true
        fi
        ;;
esac
exit 0
