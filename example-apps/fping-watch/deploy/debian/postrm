#!/bin/sh
# remove keeps the env file, target list and history (and masks the unit,
# so a leftover enable link cannot start a binary that is gone); purge
# deletes them. DynamicUser keeps the state in /var/lib/private, linked
# from /var/lib.
set -e
[ -d /run/systemd/system ] && systemctl --system daemon-reload >/dev/null || true
case "$1" in
    remove)
        deb-systemd-helper mask fping-watch.service >/dev/null || true
        ;;
    purge)
        deb-systemd-helper purge fping-watch.service >/dev/null || true
        deb-systemd-helper unmask fping-watch.service >/dev/null || true
        rm -rf /etc/fping-watch /var/lib/fping-watch /var/lib/private/fping-watch
        ;;
esac
exit 0
